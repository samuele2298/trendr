{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "dev",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/app.js",
            "outputCapture": "std",
            "env": {
                "APP_NAME": "Trendr",
                "PORT": "3000",
                "NODE_ENV": "development",
                
                "DB": "postgresql://trendr:postgres@64.226.93.50:5432/rate",

                //Logger
                "LOG_LEVEL": "debug",
                //Redis
                "REDIS_URL": "redis://localhost:6379",

            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "prod",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/app.js",
            "outputCapture": "std",
            "env": {
                "APP_NAME": "Trendr",
                "PORT": "4000",
                "NODE_ENV": "production",

                "DB": "postgresql://trendr:postgres@64.226.93.50:5432/rate",

                //Logger
                "LOG_LEVEL": "debug",
                //Redis
                "REDIS_URL": "redis://localhost:6379",
            }
        }
    ]
}